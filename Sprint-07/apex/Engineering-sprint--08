/* NotificatioService */

public with sharing class NotificationService {

    public static void sendNotification(List<Application__c> applications){

        for(Application__c app : applications){

            if(app.Status__c == 'Selected'){
                System.debug('Congratulations Email Sent');
            }
            else if(app.Status__c == 'Rejected'){
                System.debug('Rejection Email Sent');
            }
            else if(app.Status__c == 'Interview Scheduled'){
                System.debug('Interview Notification Sent');
            }
            else if(app.Status__c == 'Offer Accepted'){
                System.debug('Offer Accepted Notification Sent');
            }

        }

    }

}

/* Tigger */

trigger ApplicationTrigger on Application__c (after update) {

    NotificationService.sendNotification(Trigger.new);

}

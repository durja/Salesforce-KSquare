/* ApplicationService class*/

public class ApplicationService {
    public static void ValidateApplications(List<Application__c> applications){
        for(Application__c app : applications){
            if(app.Student__c==null){
                app.addError('Student is required');
            }
            if(app.Job__c==null){
                app.addError('Job is required');
            }
            List<Application__c> existingApps = [
                SELECT Id
                FROM Application__c
                WHERE Student__c = :app.Student__c
                AND Job__c = :app.Job__c
                LIMIT 1
            ];

            if (!existingApps.isEmpty()) {
                app.addError('Student has already applied for this job.');
            }
        }
    }

}

/* trigger */

trigger ApplicationTrigger on Application__c (before insert) {
    if(trigger.isBefore && trigger.isAfter){
        ApplicationService.ValidateApplications(Trigger.new);
    }
}
